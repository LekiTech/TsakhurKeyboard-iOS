      }
    },
    "Every one of them can also be typed key by key: к, then Ӏ; г, then ъ. Doubled letters (аа, ее, лл, кк) are typed by tapping the key twice." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every one of them can also be typed key by key: к, then Ӏ; г, then ъ. Doubled letters (аа, ее, лл, кк) are typed by tapping the key twice."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любую из них можно набрать и по буквам: к, затем Ӏ; г, затем ъ. Удвоенные буквы (аа, ее, лл, кк) набираются двойным нажатием клавиши."
          }
        }
      }
    },
    "Feels native" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feels native"
          }
