{
  "sourceLanguage" : "en",
  "strings" : {
    "About 1,350 Tsakhur words, fully offline; the keyboard learns the rest from you" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About 1,350 Tsakhur words, fully offline; the keyboard learns the rest from you"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около 1 350 цахурских слов, полностью офлайн; остальному клавиатура учится у вас"
          }
        }
      }
    },
    "Developed by LekiTech" : {
      "localizations" : {
        "en" : {
