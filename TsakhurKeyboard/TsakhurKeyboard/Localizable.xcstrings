    },
    "Hold a key to see more letters, then slide to the one you need." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold a key to see more letters, then slide to the one you need."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте клавишу, чтобы увидеть другие буквы, и проведите пальцем к нужной."
          }
        }
      }
    },
    "How to install" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How to install"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как установить"
          }
        }
      }
    },
    "It comes from a single list of dictionary forms, so it is small and does not know yet which words are common. Native speakers have not reviewed it. The keyboard learns the words you type and suggests them next time." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It comes from a single list of dictionary forms, so it is small and does not know yet which words are common. Native speakers have not reviewed it. The keyboard learns the words you type and suggests them next time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он собран по одному списку словарных форм, поэтому невелик и пока не знает, какие слова употребляются чаще. Носители языка его ещё не проверяли. Клавиатура запоминает слова, которые вы набираете, и подсказывает их в следующий раз."
          }
        }
      }
    },
    "Keyboard settings" : {
