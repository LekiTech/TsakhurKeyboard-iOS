    "Matches the iOS keyboard down to the details, in light and dark mode" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matches the iOS keyboard down to the details, in light and dark mode"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторяет клавиатуру iOS до мелочей — в светлой и тёмной теме"
          }
        }
      }
    },
    "Never asks for Full Access and sends nothing anywhere — word learning stays on this device and can be reset from the keyboard" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Never asks for Full Access and sends nothing anywhere — word learning stays on this device and can be reset from the keyboard"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не требует полного доступа и ничего никуда не отправляет — выученные слова остаются на этом устройстве, их можно удалить в настройках клавиатуры"
          }
        }
      }
    },
    "Open Settings" : {
